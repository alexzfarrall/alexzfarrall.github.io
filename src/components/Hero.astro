---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Seal from './Seal.astro';

interface Props {
  pitch: string;
  credential: { title: string; issuer: string; year: number; mark: string; kicker?: string; caption: string; url?: string };
  photo: ImageMetadata;
  photoAlt: string;
}
const { pitch, credential, photo, photoAlt } = Astro.props;
---
<section class="hero container" id="top">
  <div class="hero__text">
    <h1 class="hero__headline enter enter--lift">Engineer, founder and researcher.</h1>
    <p class="hero__pitch enter enter--fade" style="--i: 1">{pitch}</p>
    <a class="hero__cta enter enter--fade" style="--i: 2" href="#contact">Send me your challenge <span aria-hidden="true">↓</span></a>
  </div>
  <figure class="portrait">
    <Image
      src={photo}
      alt={photoAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 62rem) 40vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <Seal title={credential.title} issuer={credential.issuer} year={credential.year} mark={credential.mark} kicker={credential.kicker} caption={credential.caption} url={credential.url || undefined} />
  </figure>
</section>

<style>
  .hero { display: grid; gap: 2.5rem; align-items: end; padding-block: 1rem 2.5rem; }
  @media (min-width: 62rem) {
    .hero { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 4rem; align-items: stretch; }
    .hero__text { display: flex; flex-direction: column; justify-content: flex-start; align-items: flex-start; }
    /* Pull the first line's cap-height up to the portrait's top edge (offsets line-height leading). */
    .hero__headline { margin-top: -0.12em; }
  }
  .hero__headline {
    font: 300 clamp(2.8rem, 7.2vw, 5.6rem) / 0.98 var(--font-display);
    letter-spacing: -0.035em; margin: 0 0 1.75rem;
  }
  .hero__pitch {
    font: 400 clamp(1.15rem, 2vw, 1.45rem) / 1.45 var(--font-display);
    color: var(--ink-soft); margin: 0 0 1.75rem; max-width: 32ch;
  }
  .hero__cta {
    display: inline-block; font: 500 0.95rem var(--font-body); padding: 0.8rem 1.3rem; border-radius: 99px;
    background: var(--ink); color: var(--paper); text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .hero__cta:hover { background: var(--accent); }
  .portrait { position: relative; margin: 0; }
  .portrait :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; display: block; border-radius: 2px;
  }
  @media (max-width: 62rem) { .portrait { margin-bottom: 2rem; } }
</style>
