---
interface Props { title: string; issuer: string; year: number; mark: string; kicker?: string; caption: string; url?: string }
const { title, issuer, year, mark, kicker, caption, url } = Astro.props;
const label = `${title}, ${issuer}, ${year}`;
// Leading and trailing non-breaking spaces survive whitespace collapsing so the ring joins as "2026 · TOP".
const text = ` ${title.toUpperCase()} · ${issuer.toUpperCase()} · ${year} · `;
const [first, ...rest] = caption.split(' ');
const second = rest.join(' ');
const Tag = url ? 'a' : 'div';
const attrs = url ? { href: url, 'aria-label': label } : { role: 'img' as const, 'aria-label': label };
---
<Tag class="seal" data-seal {...attrs}>
  <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs><path id="seal-path" d="M50,50 m-39,0 a39,39 0 1,1 78,0 a39,39 0 1,1 -78,0" /></defs>
    <circle cx="50" cy="50" r="44" fill="none" stroke="var(--seal-ring)" stroke-width="0.4" />
    <g class="seal__ring">
      <text class="seal__text"><textPath href="#seal-path" textLength="244" lengthAdjust="spacing">{text}</textPath></text>
    </g>
  </svg>
  <span class="seal__core" aria-hidden="true">
    <span>
      <span class="seal__markwrap">{kicker && <span class="seal__kicker">{kicker}</span>}<b>{mark}</b></span>
      <small>{first}<svg class="seal__chevrons" aria-hidden="true" viewBox="0 0 22 10" focusable="false"><polygon points="0,0 5,0 10,5 5,10 0,10 5,5" /><polygon points="11,0 16,0 21,5 16,10 11,10 16,5" /></svg>{second && <><br />{second}</>}</small>
    </span>
  </span>
</Tag>

<style>
  .seal {
    position: absolute; left: -3.25rem; bottom: 2rem; width: 8.5rem; height: 8.5rem;
    border-radius: 50%; background: var(--seal-bg);
    text-decoration: none; color: var(--seal-ink);
  }
  .seal svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seal__ring { transform-origin: 50% 50%; will-change: transform; }
  .seal__text { font: 600 6.2px var(--font-body); fill: var(--seal-accent); }
  .seal__core { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; }
  .seal__core > span { max-width: 55%; }
  .seal__core b {
    display: block; font: 800 2.5rem/0.9 var(--font-body); color: var(--seal-accent); letter-spacing: -0.04em;
  }
  .seal__markwrap { display: inline-block; text-align: left; }
  .seal__kicker {
    display: block; font: 700 0.5rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--seal-ink); margin: 0 0 0.12rem 0.08em;
  }
  .seal__core small { display: block; font: 500 0.62rem/1.05 var(--font-body); color: var(--seal-ink); margin-top: 0.2rem; }
  .seal__core .seal__chevrons {
    position: static; display: inline-block; width: auto; height: 0.75em; margin-left: 0.2em;
    vertical-align: -0.05em; fill: var(--seal-chevron);
  }
  @media (max-width: 62rem) {
    .seal { left: auto; right: 1rem; bottom: -2rem; width: 7rem; height: 7rem; }
    .seal__core b { font-size: 1.8rem; }
    .seal__kicker { font-size: 0.38rem; }
    .seal__core small { font-size: 0.48rem; }
  }
</style>
