---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { serializeJsonLd } from '../lib/json-ld';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  name?: string;
  sameAs: string[];
  jobTitle?: string;
  email?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogImage?: ImageMetadata;
}
const { title, description, image, sameAs, jobTitle, email, imageAlt, noindex, ogImage } = Astro.props;
const base = Astro.site ?? Astro.url;
const og = ogImage
  ? await getImage({ src: ogImage, width: Math.min(1200, ogImage.width), format: 'jpg', quality: 70 })
  : await getImage({ src: image, width: 1200, height: 1200, format: 'jpg', quality: 70 });
const ogWidth = Number(og.attributes.width ?? 1200);
const ogHeight = Number(og.attributes.height ?? 1200);
const icon32 = await getImage({ src: image, width: 32, height: 32, format: 'png' });
const icon180 = await getImage({ src: image, width: 180, height: 180, format: 'png' });
const ogUrl = new URL(og.src, base).href;
const canonical = new URL(Astro.url.pathname, base).href;
const siteRoot = new URL('/', base).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alexz Farrall',
  honorificPrefix: 'Dr',
  url: siteRoot,
  image: ogUrl,
  ...(jobTitle ? { jobTitle } : {}),
  ...(email ? { email: `mailto:${email}` } : {}),
  sameAs: sameAs.filter(Boolean),
  knowsAbout: ['Robotics', 'Digital health', 'Agriculture technology', 'Human–robot interaction'],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#f7f5f0" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/png" sizes="32x32" href={icon32.src} />
<link rel="apple-touch-icon" sizes="180x180" href={icon180.src} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Dr Alexz Farrall" />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={imageAlt || 'Dr Alexz Farrall'} />
<meta property="og:url" content={noindex ? siteRoot : canonical} />
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:image" content={ogUrl} />
{!noindex && <script type="application/ld+json" set:html={serializeJsonLd(person)} />}
