---
// Where the challenge form lands for visitors without JavaScript (Web3Forms redirects here).
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { resolveImage } from '../lib/uploads';

const entry = await getEntry('site', 'site');
if (!entry) throw new Error('Missing src/content/site/site.yml');
const site = entry.data;
---
<Base
  title={`Thank you · ${site.name}`}
  description={site.description}
  image={resolveImage(site.socialImage)}
  name={site.name}
  sameAs={[]}
  noindex
>
  <main class="thanks">
    <h1>Thank you.</h1>
    <p>Your challenge is on its way. I'll reply to the email you gave.</p>
    <p><a href="/">Back to the homepage</a></p>
  </main>
</Base>

<style>
  .thanks { max-width: 40rem; margin: 0 auto; padding: 4rem var(--gutter); }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 1rem; }
  p { color: var(--ink-soft); }
  a { color: var(--accent); }
</style>
